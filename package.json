{
  "name": "cypress-formularms",
  "version": "1.1.0",
  "description": "Cypress E2E Test Suite for Formula RMS",
  "scripts": {
    "cy:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cy:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:safari": "cypress run --browser webkit",
    "cy:run:signup": "cypress run --spec 'cypress/e2e/01-signup.cy.js'",
    "cy:run:homepage": "cypress run --spec 'cypress/e2e/02-homepage.cy.js'",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/03-auth.cy.js'",
    "cy:run:menu": "cypress run --spec 'cypress/e2e/04-menu.cy.js'",
    "cy:run:categories": "cypress run --spec 'cypress/e2e/05-categories.cy.js'",
    "cy:run:items": "cypress run --spec 'cypress/e2e/06-items.cy.js'",
    "cy:run:orders": "cypress run --spec 'cypress/e2e/07-orders.cy.js'",
    "cy:run:tables": "cypress run --spec 'cypress/e2e/08-tables.cy.js'",
    "cy:run:settings": "cypress run --spec 'cypress/e2e/09-settings.cy.js'",
    "cy:run:responsive": "cypress run --spec 'cypress/e2e/10-responsive.cy.js'",
    "cy:run:console": "cypress run --spec 'cypress/e2e/11-console-errors.cy.js'",
    "cy:run:e2e": "cypress run --spec 'cypress/e2e/12-e2e-flow.cy.js'",
    "cy:run:dashboard": "cypress run --spec 'cypress/e2e/13-dashboard.cy.js'",
    "cy:run:order-lifecycle": "cypress run --spec 'cypress/e2e/14-order-lifecycle.cy.js'",
    "cy:run:billing": "cypress run --spec 'cypress/e2e/15-billing.cy.js'",
    "cy:run:table-sessions": "cypress run --spec 'cypress/e2e/16-table-sessions.cy.js'",
    "cy:run:search": "cypress run --spec 'cypress/e2e/17-search-filter.cy.js'",
    "cy:run:api-health": "cypress run --spec 'cypress/e2e/18-api-health.cy.js'",
    "cy:run:permissions": "cypress run --spec 'cypress/e2e/19-permissions.cy.js'",
    "cy:run:network-errors": "cypress run --spec 'cypress/e2e/20-network-errors.cy.js'",
    "cy:run:a11y": "cypress run --spec 'cypress/e2e/21-accessibility.cy.js'",
    "cy:run:security": "cypress run --spec 'cypress/e2e/22-security.cy.js'",
    "cy:run:reports": "cypress run --spec 'cypress/e2e/23-reports.cy.js'",
    "cy:run:performance": "cypress run --spec 'cypress/e2e/24-performance.cy.js'",
    "cy:run:menu-availability": "cypress run --spec 'cypress/e2e/25-menu-availability.cy.js'",
    "cy:run:full-flow": "cypress run --browser chrome --spec 'cypress/e2e/26-full-flow.cy.js'",
    "cy:run:full-flow:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/26-full-flow.cy.js'",
    "cy:run:smoke": "cypress run --browser chrome --spec 'cypress/e2e/01-signup.cy.js,cypress/e2e/02-homepage.cy.js,cypress/e2e/03-auth.cy.js,cypress/e2e/13-dashboard.cy.js'",
    "cy:run:smoke:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/01-signup.cy.js,cypress/e2e/02-homepage.cy.js,cypress/e2e/03-auth.cy.js,cypress/e2e/13-dashboard.cy.js'",
    "cy:run:menu-suite": "cypress run --browser chrome --spec 'cypress/e2e/04-menu.cy.js,cypress/e2e/05-categories.cy.js,cypress/e2e/06-items.cy.js,cypress/e2e/25-menu-availability.cy.js'",
    "cy:run:menu-suite:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/04-menu.cy.js,cypress/e2e/05-categories.cy.js,cypress/e2e/06-items.cy.js,cypress/e2e/25-menu-availability.cy.js'",
    "cy:run:order-suite": "cypress run --browser chrome --spec 'cypress/e2e/07-orders.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/16-table-sessions.cy.js,cypress/e2e/26-full-flow.cy.js'",
    "cy:run:order-suite:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/07-orders.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/16-table-sessions.cy.js,cypress/e2e/26-full-flow.cy.js'",
    "cy:run:functional": "cypress run --browser chrome --spec 'cypress/e2e/03-auth.cy.js,cypress/e2e/04-menu.cy.js,cypress/e2e/05-categories.cy.js,cypress/e2e/06-items.cy.js,cypress/e2e/07-orders.cy.js,cypress/e2e/08-tables.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/16-table-sessions.cy.js,cypress/e2e/17-search-filter.cy.js,cypress/e2e/26-full-flow.cy.js'",
    "cy:run:functional:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/03-auth.cy.js,cypress/e2e/04-menu.cy.js,cypress/e2e/05-categories.cy.js,cypress/e2e/06-items.cy.js,cypress/e2e/07-orders.cy.js,cypress/e2e/08-tables.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/16-table-sessions.cy.js,cypress/e2e/17-search-filter.cy.js,cypress/e2e/26-full-flow.cy.js'",
    "cy:run:quality": "cypress run --browser chrome --spec 'cypress/e2e/10-responsive.cy.js,cypress/e2e/11-console-errors.cy.js,cypress/e2e/21-accessibility.cy.js,cypress/e2e/24-performance.cy.js'",
    "cy:run:quality:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/10-responsive.cy.js,cypress/e2e/11-console-errors.cy.js,cypress/e2e/21-accessibility.cy.js,cypress/e2e/24-performance.cy.js'",
    "cy:run:security-suite": "cypress run --browser chrome --spec 'cypress/e2e/19-permissions.cy.js,cypress/e2e/20-network-errors.cy.js,cypress/e2e/22-security.cy.js'",
    "cy:run:reports-suite": "cypress run --browser chrome --spec 'cypress/e2e/13-dashboard.cy.js,cypress/e2e/23-reports.cy.js'",
    "cy:run:reports-suite:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/13-dashboard.cy.js,cypress/e2e/23-reports.cy.js'",
    "cy:run:sanity": "cypress run --browser chrome --spec 'cypress/e2e/02-homepage.cy.js,cypress/e2e/03-auth.cy.js,cypress/e2e/13-dashboard.cy.js,cypress/e2e/04-menu.cy.js,cypress/e2e/07-orders.cy.js,cypress/e2e/08-tables.cy.js,cypress/e2e/18-api-health.cy.js,cypress/e2e/26-full-flow.cy.js'",
    "cy:run:invoice-kot": "cypress run --browser chrome --spec 'cypress/e2e/29-invoice-kot-settings.cy.js'",
    "cy:run:invoice-kot:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/29-invoice-kot-settings.cy.js'",
    "cy:run:staff": "cypress run --browser chrome --spec 'cypress/e2e/28-staff.cy.js'",
    "cy:run:staff:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/28-staff.cy.js'",
    "cy:run:regression": "cypress run --browser chrome --spec 'cypress/e2e/27-regression.cy.js' --retries 1",
    "cy:run:regression:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/27-regression.cy.js' --retries 1",
    "cy:run:regression:full": "cypress run --browser chrome --retries 1",
    "cy:run:regression:full:headed": "cypress run --browser chrome --headed --retries 1",
    "cy:run:gsheet": "cypress run --browser chrome --spec 'cypress/e2e/30-google-sheet-testcases.cy.js'",
    "cy:run:gsheet:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/30-google-sheet-testcases.cy.js'",
    "cy:run:clear-orders": "cypress run --browser chrome --spec 'cypress/e2e/31-clear-orders.cy.js'",
    "cy:run:clear-orders:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/31-clear-orders.cy.js'",
    "cy:run:user-profile": "cypress run --browser chrome --spec 'cypress/e2e/32-user-profile.cy.js'",
    "cy:run:user-profile:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/32-user-profile.cy.js'",
    "cy:run:profile-buttons": "cypress run --browser chrome --spec 'cypress/e2e/33-profile-buttons.cy.js'",
    "cy:run:profile-buttons:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/33-profile-buttons.cy.js'",
    "cy:run:preferences": "cypress run --browser chrome --spec 'cypress/e2e/34-preferences-buttons.cy.js'",
    "cy:run:preferences:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/34-preferences-buttons.cy.js'",
    "cy:run:profile-suite": "cypress run --browser chrome --spec 'cypress/e2e/32-user-profile.cy.js,cypress/e2e/33-profile-buttons.cy.js,cypress/e2e/34-preferences-buttons.cy.js'",
    "cy:run:profile-suite:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/32-user-profile.cy.js,cypress/e2e/33-profile-buttons.cy.js,cypress/e2e/34-preferences-buttons.cy.js'",
    "cy:run:signup-full": "cypress run --browser chrome --spec 'cypress/e2e/35-signup-comprehensive.cy.js'",
    "cy:run:signup-full:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/35-signup-comprehensive.cy.js'",
    "cy:run:critical": "cypress run --browser chrome --spec 'cypress/e2e/03-auth.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/12-e2e-flow.cy.js,cypress/e2e/26-full-flow.cy.js,cypress/e2e/27-regression.cy.js'",
    "cy:run:critical:headed": "cypress run --browser chrome --headed --spec 'cypress/e2e/03-auth.cy.js,cypress/e2e/14-order-lifecycle.cy.js,cypress/e2e/15-billing.cy.js,cypress/e2e/12-e2e-flow.cy.js,cypress/e2e/26-full-flow.cy.js,cypress/e2e/27-regression.cy.js'",
    "setup:kitchen-printer": "cypress run --browser chrome --headed --spec 'cypress/e2e/setup/assign-kitchen-printer.cy.js'",
    "setup:clear-orders": "cypress run --browser chrome --headed --spec 'cypress/e2e/setup/clear-all-orders.cy.js'",
    "cy:run:all": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports,overwrite=false,html=true,json=true",
    "cy:run:ci": "cypress run --browser chrome --retries 2 --reporter mochawesome --reporter-options reportDir=cypress/reports/ci,overwrite=false,html=false,json=true",
    "cy:run:nightly": "cypress run --browser chrome --retries 1 --reporter mochawesome --reporter-options reportDir=cypress/reports/nightly,overwrite=false,html=true,json=true",
    "cy:report:merge": "rm -f cypress/reports/merged.json && mochawesome-merge 'cypress/reports/mochawesome_*.json' > cypress/reports/merged.json",
    "cy:report:generate": "marge cypress/reports/merged.json -f report -o cypress/reports/html",
    "cy:report:full": "npm run cy:run:all && npm run cy:report:merge && npm run cy:report:generate",
    "add:order-items": "OTP_CODE=$OTP_CODE node scripts/add-order-items.js",
    "add:item-images": "OTP_CODE=$OTP_CODE node scripts/add-item-images.js",
    "populate:menu-items": "OTP_CODE=$OTP_CODE node scripts/populate-menu-items.js",
    "test:api": "node scripts/run-tests.js",
    "test:api:auth": "OTP_CODE=$OTP_CODE node scripts/run-tests.js",
    "report:pdf": "node scripts/generate-pdf.js",
    "report:cypress-pdf": "node scripts/generate-cypress-pdf.js",
    "test:full-report": "node scripts/run-tests.js && node scripts/generate-pdf.js",
    "automate": "node scripts/automate.js",
    "automate:smoke": "SUITE=smoke node scripts/automate.js",
    "automate:functional": "SUITE=functional node scripts/automate.js",
    "automate:profile": "SUITE=profile node scripts/automate.js",
    "automate:regression": "SUITE=regression node scripts/automate.js",
    "automate:ci": "SUITE=regression HEADED=0 OTP_CODE=$OTP_CODE node scripts/automate.js",
    "report:regression": "node scripts/generate-regression-report.js",
    "load:token": "OTP_CODE=$OTP_CODE node scripts/get-token.js",
    "fetch:otp": "IMAP_PASS=$IMAP_PASS node scripts/get-otp-email.js",
    "load:test": "JAVA_HOME=$(dirname $(dirname $(readlink -f $(find /home/bottle/.antigravity -name java | head -1)))) && mkdir -p jmeter/results && jmeter/jmeter-bin/bin/jmeter -n -t jmeter/formularms-orders-load.jmx -l jmeter/results/orders-load-results.jtl -e -o jmeter/results/html-report 2>&1",
    "load:report": "jmeter/jmeter-bin/bin/jmeter -g jmeter/results/orders-load-results.jtl -o jmeter/results/html-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "cypress": "^13.17.0",
    "cypress-real-events": "^1.15.0",
    "imapflow": "^1.3.3",

    "mailparser": "^3.9.8",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "pdfkit": "^0.18.0"
  },
  "author": "Formula RMS QA Team",
  "license": "MIT"
}
